# Bootstrap credentials only. These authenticate the services to Infisical -
# they are NOT the application secrets themselves (URLs/ports live in Infisical).
# Copy this file to .env and fill in real values. .env is gitignored.

# Infisical machine identity (Universal Auth) - one identity shared by all
# services, or create one per service and override in docker-compose.yml.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

INFISICAL_PROJECT_ID=
# The Infisical environment slug to read secrets from (e.g. dev, staging, prod)
INFISICAL_ENVIRONMENT=dev
# Only needed for self-hosted Infisical. Defaults to https://app.infisical.com
INFISICAL_SITE_URL=

# Used only by docker-compose to publish/expose container ports at startup
# (Docker needs these before any container code runs, so they can't come
# from inside the app). Keep these equal to the API_GATEWAY_PORT /
# AUTH_SERVICE_PORT / NON_AUTH_SERVICE_PORT secrets stored in Infisical -
# see README.md for how to keep them in sync.
API_GATEWAY_PORT=
AUTH_SERVICE_PORT=
NON_AUTH_SERVICE_PORT=
